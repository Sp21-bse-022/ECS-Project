{
  "containerDefinitions": [
    {
      "name": "Main",
      "image": "656972167486.dkr.ecr.us-east-1.amazonaws.com/ecs1/ecs-project:bootstrap",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp",
          "name": "main-80-tcp",
          "appProtocol": "http"
        },
        {
          "containerPort": 3968,
          "hostPort": 3968,
          "protocol": "tcp",
          "name": "main-3968-tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [],
      "environmentFiles": [],
      "mountPoints": [],
      "volumesFrom": [],
      "ulimits": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ecs-project-task",
          "awslogs-create-group": "true",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"fetch('http://localhost:3968/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 10,
        "startPeriod": 3
      },
      "systemControls": []
    }
  ],
  "family": "ecs-project-task",
  "taskRoleArn": "arn:aws:iam::656972167486:role/ecsTaskExecutionRole",
  "executionRoleArn": "arn:aws:iam::656972167486:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024"
}
